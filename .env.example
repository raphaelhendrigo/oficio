# Copie para .env e preencha (nao versionar credenciais).

# Credenciais (fluxo atual: src/bot.py)
ETCM_USER=
ETCM_PASS=

# URL base (login do e-TCM)
BASE_URL=https://homologacao-etcm.tcm.sp.gov.br/paginas/login.aspx

# Downloads/artefatos
DOWNLOAD_DIR=artifacts/downloads

# Execucao
HEADLESS=false
SLOWMO_MS=150
TIMEOUT_MS=30000
MODE=run
STEPS_PATH=docs/steps.yaml

# Sessao (para reduzir captcha)
USE_STORAGE_STATE=true
STORAGE_STATE_PATH=storage_state.json

# Processos
# PROCESSOS_LIST=TC/011724/2020,TC/000123/2021
# PROCESS_ALL=true
# MAX_PROCESSOS=0
# PROCESSO=

# Campos do formulario
DESTINATARIO=Secretaria Municipal de Educacao
RELATOR=
DESCRICAO=Oficio gerado automaticamente
STATUS_ENTREGA=Urgente
PRAZO_DIAS=60

# Anexo
ANEXO_DOCX=

# Legacy (src/main.py) - use apenas se rodar o fluxo antigo
